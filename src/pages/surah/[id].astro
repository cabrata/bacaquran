---
import Layout from '../../layouts/Layout.astro';
import AyahCard from '../../components/AyahCard.astro';
import { getSurahs, getSurahById } from '../../lib/data';

export async function getStaticPaths() {
  const surahs = getSurahs();
  return surahs.map((s: any) => ({
    params: { id: String(s.id) },
    props: { id: s.id }
  }));
}

const { id } = Astro.props;
const surahData = getSurahById(id);

if (!surahData) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const isFatihah = id === 1;
const isTawbah = id === 9;
const showBismillah = !isFatihah && !isTawbah;
const bismillahAyah = showBismillah ? getSurahById(1)?.ayahs[0] : null;

// prev/next navigation
const surahs = getSurahs();
const prevSurah = id > 1 ? surahs[id - 2] : null;
const nextSurah = id < 114 ? surahs[id] : null;
---

<Layout title={`Surat ${surahData.surah.transliteration || surahData.surah.latin}`}>
  <section class="surah-header">
    <div class="wrap">
      <div class="surah-header-top">
        {prevSurah && <a href={`/surah/${prevSurah.id}`} class="nav-arrow" title={prevSurah.transliteration || prevSurah.latin}>← {prevSurah.transliteration || prevSurah.latin}</a>}
        {!prevSurah && <span></span>}
        {nextSurah && <a href={`/surah/${nextSurah.id}`} class="nav-arrow" title={nextSurah.transliteration || nextSurah.latin}>{nextSurah.transliteration || nextSurah.latin} →</a>}
      </div>
      <h1 class="surah-title">{surahData.surah.transliteration || surahData.surah.latin}</h1>
      <p class="surah-meta">{surahData.surah.translation} • {surahData.surah.num_ayah} Ayat • {surahData.surah.location}</p>
      <div class="surah-arabic-name" lang="ar" dir="rtl">{surahData.surah.arabic}</div>
    </div>
  </section>

  <section class="wrap surah-content">
    {showBismillah && bismillahAyah && (
      <div class="bismillah">
        <p class="bismillah-ar" lang="ar" dir="rtl">{bismillahAyah.arabic}</p>
        <p class="bismillah-latin">{bismillahAyah.latin}</p>
        <p class="bismillah-tr">{bismillahAyah.translation}</p>
        <button class="btn-play bismillah-btn" data-audio={bismillahAyah.audio} aria-label="Putar Basmalah">
          <svg class="ico-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <svg class="ico-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
        </button>
      </div>
    )}

    <div class="ayah-list">
      {surahData.ayahs.map((ayah: any) => (
        <AyahCard ayah={ayah} surahName={surahData.surah.transliteration || surahData.surah.latin} />
      ))}
    </div>

    <div class="surah-nav-bottom">
      {prevSurah && <a href={`/surah/${prevSurah.id}`} class="nav-btn">← {prevSurah.transliteration || prevSurah.latin}</a>}
      <a href="/" class="nav-btn nav-home">Daftar Surat</a>
      {nextSurah && <a href={`/surah/${nextSurah.id}`} class="nav-btn">{nextSurah.transliteration || nextSurah.latin} →</a>}
    </div>
  </section>
</Layout>

<style>
  .surah-header {
    text-align: center;
    padding: clamp(2rem, 5vh, 4rem) 0;
    border-bottom: 1px solid var(--border);
  }

  .surah-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .nav-arrow {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 200ms;
  }

  .nav-arrow:hover { color: var(--gold); }

  .surah-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  .surah-meta {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1rem;
  }

  .surah-arabic-name {
    font-family: 'Amiri', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--text);
    line-height: 1.4;
  }

  .surah-content {
    padding-bottom: 3rem;
  }

  /* Bismillah */
  .bismillah {
    text-align: center;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
  }

  .bismillah-ar {
    font-family: 'Amiri', serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--text);
    margin-bottom: 0.75rem;
    line-height: 2;
  }

  .bismillah-latin {
    color: var(--gold);
    font-style: italic;
    margin-bottom: 0.5rem;
  }

  .bismillah-tr {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin-bottom: 1rem;
  }

  .btn-play {
    background: none;
    border: 1px solid var(--border);
    cursor: pointer;
    color: var(--text-muted);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 200ms;
  }

  .btn-play:hover {
    color: var(--gold);
    border-color: var(--gold);
    background: var(--gold-bg);
  }

  /* Bottom navigation */
  .surah-nav-bottom {
    display: flex;
    justify-content: center;
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .nav-btn {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.625rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: all 200ms;
  }

  .nav-btn:hover {
    color: var(--gold);
    border-color: var(--gold);
    background: var(--gold-bg);
  }

  .nav-home {
    color: var(--gold);
    border-color: var(--gold);
  }
</style>
